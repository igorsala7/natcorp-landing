# Endpoint que recebe o POST JSON do formulário "Agende uma demonstração".
# Ex.: URL de webhook de automação (RD Station, HubSpot, Zapier, n8n) ou de um proxy serverless próprio.
# Sem esta variável o formulário opera em modo demonstração (nada é enviado; payload vai para o console).
VITE_LEAD_WEBHOOK_URL=

# Opcional: token enviado como header "Authorization: Bearer <token>".
# ATENÇÃO: variáveis VITE_* são embutidas no bundle público do frontend.
# Nunca coloque aqui um segredo real — use um webhook/proxy que guarde o segredo no servidor.
VITE_LEAD_WEBHOOK_TOKEN=

# Opcional: URL canônica do site (usada em meta tags / JSON-LD no build).
VITE_SITE_URL=https://www.natcorp.com.br

# Administração do cadastro dos portais (/admin/portais). O cadastro fica em src/content/portals.json e é
# gravado no repositório pela API do GitHub, com um token que fica só no navegador do administrador.
# Estes valores só apontam o destino da gravação; sem eles valem os padrões (igorsala7/natcorp-landing, main).
VITE_ADMIN_REPO_OWNER=
VITE_ADMIN_REPO=
VITE_ADMIN_BRANCH=

# Tags de marketing. SÓ CARREGAM DEPOIS DO ACEITE na barra de cookies —
# ver src/lib/consent.ts e src/lib/analytics.ts. Sem ID, nada é carregado,
# então homologação não polui os dados de produção.
VITE_GTM_ID=
VITE_META_PIXEL_ID=
