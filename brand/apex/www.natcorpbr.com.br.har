            "text": " \r\n(function () {\r\n    setInterval(() => {\r\n        $(\"input:not([type=hidden]):valid\")\r\n            .each(function (index, el) {\r\n                var patt1 = /\\w/g;    \r\n                if (el.value && el.value.match(patt1)) {\r\n                    $(el).addClass(\"borda-campo-valido\");\r\n                } else {\r\n                    $(el).removeClass(\"borda-campo-valido\");\r\n                }\r\n            });\r\n        \r\n         $(\"select:not([type=hidden]):valid\")\r\n            .each(function (index, el) {\r\n                var patt1 = /\\w/g;    \r\n                if (el.value && el.value.match(patt1)) {\r\n                    $(el).addClass(\"borda-campo-valido\");\r\n                } else {\r\n                    $(el).removeClass(\"borda-campo-valido\");\r\n                }\r\n            });\r\n    }, 2000);\r\n})();"
          },
